# Локална разработка. Копирай като .env (pnpm db:setup го прави автоматично).
# Миграции и тестови данни: собственик на схемата (суперпотребител само локално).
DATABASE_URL=postgres://postgres:postgres_dev_only@127.0.0.1:5432/kantora?sslmode=disable
# Приложението: роля без BYPASSRLS (член на app_user).
APP_DATABASE_URL=postgres://kantora_app:kantora_app_dev_only@127.0.0.1:5432/kantora?sslmode=disable
# Входът (Better Auth): роля само за схемата auth (член на auth_service).
AUTH_DATABASE_URL=postgres://kantora_auth:kantora_auth_dev_only@127.0.0.1:5432/kantora?sslmode=disable
BETTER_AUTH_URL=http://localhost:3000
# Само за локална разработка. В продукция: случаен низ от тайните на хостинга.
BETTER_AUTH_SECRET=dev_only_secret_change_me_0123456789abcdef

# Тестов профил за ръчни проверки в локалната среда (само localhost; не е реален).
DEV_TEST_OWNER_EMAIL=owner@kantora.test
DEV_TEST_OWNER_PASSWORD=Dev-nzMdvzZ27iKD
DEV_TEST_ACCOUNTANT_EMAIL=accountant@kantora.test
DEV_TEST_ACCOUNTANT_PASSWORD=Dev-BaAc0ra39LKL
# Без анонимна телеметрия от Next.js.
NEXT_TELEMETRY_DISABLED=1
